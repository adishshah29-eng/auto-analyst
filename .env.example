# Copy this file to .env and fill in ONE of the two provider keys below.
# The model name you set in ANALYSIS_MODEL picks the provider automatically
# (anything starting with "gemini" routes to Google; everything else to
# Anthropic) — no separate provider flag needed unless you want to override
# that with LLM_PROVIDER.

# --- Option A: Anthropic (Claude) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Option B: Google (Gemini) — free tier available via AI Studio:
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=...

# Model used for both the CodeAct reasoning loop and the final insight
# synthesis call. Any current Claude or Gemini model id works, e.g.
# "claude-sonnet-5" or "gemini-flash-lite-latest".
ANALYSIS_MODEL=claude-sonnet-5

# Optional: force the provider instead of inferring it from the model name.
# LLM_PROVIDER=google

# Optional: override the approximate per-million-token pricing used for
# cost estimates (agent/llm.py has a small built-in table — Anthropic
# prices are real list-price estimates, Google defaults to $0 since the
# AI Studio free tier isn't billed). Set these if you're on paid Gemini
# billing and want accurate cost numbers instead of zeros.
# ANALYSIS_MODEL_PRICE_IN=3.00
# ANALYSIS_MODEL_PRICE_OUT=15.00

# Optional: sandbox execution limits per generated code snippet. Defaults
# (15s / 1024MB) assume a normal dev machine. On a memory-constrained host
# (e.g. Streamlit Community Cloud's free tier, ~1GB shared by the whole
# app), lower the memory limit so the sandboxed child can't starve
# Streamlit itself. Tested empirically: an isolated child process needs
# ~500-700MB just to unpickle a modest dataframe + import pandas/numpy/
# matplotlib, depending on the dataset — but that isolated number doesn't
# account for the *host* Streamlit process's own footprint competing for
# the same ~1GB total on a live deploy, which local single-process testing
# can't fully reproduce. Don't chase one "correct" number here: a snippet
# that fails from memory pressure now retries once with double this limit
# before falling back to an LLM rewrite (agent/stages/common.py), and any
# remaining failure reports a real, diagnosable error instead of an opaque
# crash — so it's safe to start around 700MB and let the retry cover the
# rest, then check the app's execution log / host logs if failures persist.
# SANDBOX_TIMEOUT_SECONDS=15
# SANDBOX_MEMORY_LIMIT_MB=700
