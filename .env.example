# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for both the CodeAct reasoning loop and the final insight
# synthesis call. Any current Claude model id works; defaults to the
# latest Sonnet if unset.
ANALYSIS_MODEL=claude-sonnet-5

# Optional: override the approximate per-million-token pricing used for
# cost estimates (agent/llm.py has a small built-in table, but prices
# change — set these if you want accurate numbers for your model).
# ANALYSIS_MODEL_PRICE_IN=3.00
# ANALYSIS_MODEL_PRICE_OUT=15.00
